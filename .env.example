# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# Riddi 不绑定任何厂商后端：端点默认指向本机自托管服务（http://localhost:8787）。
ZCODE_BASE_URL=http://localhost:8787
# OAuth 账号链路已整体移除，以下 Z.ai/BigModel 变量不再使用。

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=http://localhost:8787/cn/share

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
